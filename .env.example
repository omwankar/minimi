# Required. https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Cheap default. The server forces thinking off so reasoning tokens are not billed.
# deepseek-v4-pro is stronger and much more expensive. Leave this on flash.
LLM_MODEL=deepseek-flash

# Search. Leave both blank to use DuckDuckGo, which costs $0.
# Brave Search is the quality upgrade: https://api.search.brave.com
# ($5 per 1,000 queries, $5 of credit each month). Attribute Brave if you use the credit.
# BRAVE_SEARCH_API_KEY=
# Tavily basic search: https://tavily.com
# TAVILY_API_KEY=
SEARCH_PROVIDER=auto

# IANA zone for "Monday" and "last Tuesday". Defaults to the machine timezone.
# USER_TIMEZONE=Asia/Kolkata

PORT=8787
# One query per remembered product, hard cap. The graded shortlist is 5.
MAX_SEARCHES=5
